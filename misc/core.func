# shellcheck shell=bash
#
# misc/core.func - shared basics for proxmox-recipes.
#
# Terminal output, logging, the step runner (spinner + log capture), the
# error trap and host preflight checks. Sourced by misc/build.func.
#
# Nothing in this file reads user input; only the menu layer in
# misc/build.func does that.

if [[ -n "${RCP_CORE_LOADED:-}" ]]; then
  return 0
fi
RCP_CORE_LOADED=1

# ---- terminal output --------------------------------------------------------

if [[ -t 1 && "${TERM:-dumb}" != "dumb" ]]; then
  RCP_TTY=1
  C_RESET=$'\e[0m'
  C_BOLD=$'\e[1m'
  C_RED=$'\e[31m'
  C_GREEN=$'\e[32m'
  C_YELLOW=$'\e[33m'
  C_BLUE=$'\e[34m'
else
  RCP_TTY=0
  C_RESET=""
  C_BOLD=""
  C_RED=""
  C_GREEN=""
  C_YELLOW=""
  C_BLUE=""
fi

say()      { printf '%s\n' "$*"; }
say_head() { printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
say_ok()   { printf ' %s[ ok ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
say_warn() { printf ' %s[warn]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
say_err()  { printf ' %s[fail]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }

# ---- logging ----------------------------------------------------------------
#
# The log starts under a temporary name because the container ID is not
# known until the settings are collected; log_bind_ctid renames it to
# /var/log/proxmox-recipes/<app>-<ctid>.log.

RCP_LOG_DIR="/var/log/proxmox-recipes"
RCP_LOG=""

log_line() {
  if [[ -n "$RCP_LOG" ]]; then
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$RCP_LOG"
  fi
}

log_start() {   # <app slug>
  mkdir -p "$RCP_LOG_DIR"
  RCP_LOG="${RCP_LOG_DIR}/${1}-pending-$$.log"
  (umask 077; : >"$RCP_LOG")
  log_line "==== proxmox-recipes: $1 started ===="
}

# A run that was cancelled before a container ID was chosen created
# nothing, so its pending log is not worth keeping.
log_discard_pending() {
  if [[ "$RCP_LOG" == "${RCP_LOG_DIR}/"*-pending-*.log ]]; then
    rm -f -- "$RCP_LOG"
    RCP_LOG=""
  fi
}

log_bind_ctid() {   # <app slug> <ctid>
  local final="${RCP_LOG_DIR}/${1}-${2}.log"
  (umask 077; cat -- "$RCP_LOG" >>"$final")
  chmod 600 "$final"
  rm -f -- "$RCP_LOG"
  RCP_LOG=$final
}

# ---- failure handling -------------------------------------------------------
#
# Any failed command (ERR trap), die, or Ctrl-C ends up in rcp_fail. It
# reports the step that was running and the tail of the log, then calls
# rcp_on_failure if the caller defined one (build.func uses it to offer
# removing a half-built container).

RCP_STEP=""

step_begin() { RCP_STEP=$1; }
step_end()   { RCP_STEP=""; }

rcp_fail() {   # <exit code> <message>
  trap - ERR INT TERM
  set +e
  if (( RCP_TTY )); then printf '\r\e[K'; fi
  log_line "FAILED: $2"
  say_err "$2"
  if [[ -n "$RCP_STEP" ]]; then
    say_err "Failed step: $RCP_STEP"
  fi
  if [[ -s "$RCP_LOG" ]]; then
    say "   Last lines of $RCP_LOG:"
    tail -n 15 -- "$RCP_LOG" | sed 's/^/     /'
  fi
  if declare -F rcp_on_failure >/dev/null; then
    rcp_on_failure
  fi
  exit "$1"
}

rcp_trap_err() {   # <rc> <where> <command>
  rcp_fail "$1" "Command failed (exit $1) at $2: $3"
}

die() { rcp_fail 1 "$*"; }

rcp_install_traps() {
  trap 'rcp_trap_err "$?" "${BASH_SOURCE[0]##*/}:${LINENO}" "$BASH_COMMAND"' ERR
  trap 'rcp_fail 130 "Interrupted."' INT TERM
  trap rcp_remove_tmp EXIT
}

# ---- temporary files --------------------------------------------------------
#
# Host-side temp files are registered here and removed on every exit,
# including failures and Ctrl-C.

RCP_TMP_FILES=()

rcp_mktemp() {   # <variable to receive the path>
  local f
  f=$(mktemp)
  RCP_TMP_FILES+=("$f")
  printf -v "$1" '%s' "$f"
}

rcp_remove_tmp() {
  if (( ${#RCP_TMP_FILES[@]} )); then
    rm -f -- "${RCP_TMP_FILES[@]}"
  fi
}

# ---- step runner ------------------------------------------------------------
#
# run_step "<message>" <command> [args...]
# Runs the command in a background subshell with all output going to the
# log, shows a spinner while it runs, and prints ok or returns its exit
# code (which then trips the ERR trap in the caller). Steps run in a
# subshell, so they cannot change the caller's variables.

run_step() {
  local msg=$1 pid rc=0 n=0 frames="|/-\\"
  shift
  RCP_STEP=$msg
  log_line "STEP: $msg"
  (
    trap - ERR INT TERM
    "$@"
  ) </dev/null >>"$RCP_LOG" 2>&1 &
  pid=$!
  if (( RCP_TTY )); then
    while kill -0 "$pid" 2>/dev/null; do
      printf '\r %s[ %s  ]%s %s' "$C_BLUE" "${frames:n%4:1}" "$C_RESET" "$msg"
      n=$((n + 1))
      sleep 0.15
    done
    printf '\r\e[K'
  else
    say " [ .. ] $msg"
  fi
  wait "$pid" || rc=$?
  if (( rc != 0 )); then
    log_line "STEP FAILED (exit $rc): $msg"
    return "$rc"
  fi
  log_line "STEP OK: $msg"
  RCP_STEP=""
  say_ok "$msg"
}

# ---- preflight --------------------------------------------------------------

preflight_checks() {
  RCP_STEP="Preflight checks"
  if (( EUID != 0 )); then
    die "Run this as root on the Proxmox VE host."
  fi
  if ! command -v pveversion >/dev/null 2>&1 || ! command -v pct >/dev/null 2>&1; then
    die "This does not look like a Proxmox VE host (pveversion/pct not found)."
  fi
  local ver major
  ver=$(pveversion)
  major=$(sed -n 's#^pve-manager/\([0-9][0-9]*\)\..*#\1#p' <<<"$ver")
  if [[ ! "$major" =~ ^[0-9]+$ ]] || (( major < 8 )); then
    die "Proxmox VE 8 or newer is required (found: $ver)."
  fi
  if [[ "$(dpkg --print-architecture)" != "amd64" ]]; then
    die "Only amd64 hosts are supported."
  fi
  if ! curl -fsS --max-time 15 -o /dev/null http://download.proxmox.com/images/; then
    die "No internet access: cannot reach download.proxmox.com."
  fi
  log_line "Preflight ok: $ver"
  RCP_STEP=""
  say_ok "Preflight checks (root, PVE ${major}, amd64, internet)"
}
