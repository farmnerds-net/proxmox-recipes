# shellcheck shell=bash
#
# misc/build.func - host-side engine for proxmox-recipes.
#
# A recipe (ct/<app>.sh) sets its APP_* metadata, sources this file and
# calls recipe_main. The flow is:
#
#   preflight -> settings (menus) -> validate -> template -> pct create
#   -> start -> wait for network -> container-side install -> summary
#
# Recipe metadata (set by ct/<app>.sh):
#   APP_NAME APP_SLUG APP_DEBIAN_RELEASE APP_DEFAULT_HOSTNAME
#   APP_DEFAULT_CORES APP_DEFAULT_RAM_MB APP_DEFAULT_DISK_GB
#   APP_INSTALL_SCRIPT   repo-relative path of install/<app>.sh
#   APP_INSTALL_INTERACTIVE  yes if the app's official installer asks its
#                        own questions; that step then runs in the
#                        foreground on the user's terminal (default no)
#   APP_ENV_VARS         array of app option variable names to pass into
#                        the container install (e.g. PIHOLE_UNBOUND)
#
# Optional recipe hooks (functions defined in ct/<app>.sh):
#   app_ask_options      ask app-specific questions with ui_* functions
#   app_validate_options die if an app option is invalid
#   app_settings_text    extra lines for the settings/confirm screen
#   app_summary_text     extra lines for the final summary
#   app_notes_rows       extra rows for the container's notes table
#                        (print them with notes_row)
#
# Source of the engine and app scripts:
#   RECIPES_SRC   local checkout to load from (host side only)
#   RECIPES_REF   git branch/tag on GitHub (default main). Also written into
#                 the container, so 'recipe update' follows the same ref.
#
# Settings. Each one is a plain variable; any that is already set (even
# to an empty string, for the optional ones) skips its menu, so a caller
# can preset some or all of them and run without questions:
#   SETUP_MODE          default | advanced
#   CT_ID               container ID (default: next free ID)
#   CT_HOSTNAME
#   CT_CORES CT_RAM_MB CT_DISK_GB CT_SWAP_MB
#   CT_STORAGE          storage for the root disk ('rootdir' content)
#   TMPL_STORAGE        storage for the template ('vztmpl' content)
#   CT_BRIDGE
#   CT_IP               dhcp | <ipv4>/<prefix>
#   CT_GATEWAY          required when CT_IP is static
#   CT_VLAN             VLAN tag, empty for none
#   CT_DNS              space separated DNS servers, empty = same as host
#   CT_PASSWORD         root password, empty = none
#   CT_SSH_KEY          root SSH public key (key text), empty = none
#   CT_ONBOOT           yes | no
#   CONFIRM_CREATE      yes skips the final confirmation
#   DESTROY_ON_FAILURE  yes | no, what to do with a half-built container
#
# Only the menu layer (the ui_* functions) reads input.

set -Eeuo pipefail

RECIPES_REF=${RECIPES_REF:-main}
if [[ ! "$RECIPES_REF" =~ ^[A-Za-z0-9._/-]+$ ]]; then
  printf 'proxmox-recipes: RECIPES_REF %q is not a valid branch or tag name\n' "$RECIPES_REF" >&2
  exit 1
fi
RECIPES_RAW_BASE="https://raw.githubusercontent.com/farmnerds-net/proxmox-recipes/${RECIPES_REF}"

# ---- loading repo files -----------------------------------------------------

recipe_fetch() {   # <repo-relative path> -> file content on stdout
  if [[ -n "${RECIPES_SRC:-}" ]]; then
    cat -- "${RECIPES_SRC%/}/$1"
  else
    curl -fsSL --retry 2 --max-time 30 "${RECIPES_RAW_BASE}/$1"
  fi
}

recipe_source() {   # <repo-relative path>
  local body
  body=$(recipe_fetch "$1") || {
    printf 'proxmox-recipes: could not load %s\n' "$1" >&2
    exit 1
  }
  # shellcheck source=/dev/null
  source /dev/stdin <<<"$body"
}

recipe_source misc/core.func

# ---- host discovery ---------------------------------------------------------

host_storages() {   # <content type> -> active storages, most free space first
  pvesm status --content "$1" 2>/dev/null |
    awk 'NR > 1 && $3 == "active" { print $6, $1 }' |
    sort -rn | awk '{ print $2 }'
}

storage_free_gib() {   # <storage>
  pvesm status 2>/dev/null |
    awk -v s="$1" '$1 == s { printf "%.0f", $6 / 1048576 }'
}

host_bridges() {
  local d
  for d in /sys/class/net/*/bridge; do
    [[ -d "$d" ]] || continue
    d=${d%/bridge}
    printf '%s\n' "${d##*/}"
  done | sort
}

in_list() {   # <needle> <newline separated list>
  grep -qxF -- "$1" <<<"$2"
}

default_ctid()    { pvesh get /cluster/nextid; }
default_storage() { local l; l=$(host_storages rootdir); printf '%s' "${l%%$'\n'*}"; }

default_tmpl_storage() {
  local l
  l=$(host_storages vztmpl)
  if in_list local "$l"; then
    printf 'local'
  else
    printf '%s' "${l%%$'\n'*}"
  fi
}

default_bridge() {
  local l
  l=$(host_bridges)
  if in_list vmbr0 "$l"; then
    printf 'vmbr0'
  else
    printf '%s' "${l%%$'\n'*}"
  fi
}

# ---- validators (return 0 if valid; no output) ------------------------------

is_uint()       { [[ "$1" =~ ^[0-9]+$ ]]; }
valid_mode()    { [[ "$1" == default || "$1" == advanced ]]; }
valid_yesno()   { [[ "$1" == yes || "$1" == no ]]; }
valid_ctid()    { is_uint "$1" && (( 10#$1 >= 100 && 10#$1 <= 999999999 )); }
ctid_free()     { pvesh get /cluster/nextid --vmid "$1" >/dev/null 2>&1; }
ctid_ok()       { valid_ctid "$1" && ctid_free "$1"; }
valid_cores()   { is_uint "$1" && (( 10#$1 >= 1 && 10#$1 <= $(nproc) )); }
valid_ram()     { is_uint "$1" && (( 10#$1 >= 128 )); }
valid_disk()    { is_uint "$1" && (( 10#$1 >= 1 )); }
valid_swap()    { is_uint "$1"; }
valid_vlan()    { [[ -z "$1" ]] || { is_uint "$1" && (( 10#$1 >= 1 && 10#$1 <= 4094 )); }; }
valid_storage() { [[ -n "$1" ]] && in_list "$1" "$(host_storages rootdir)"; }
valid_tmpl_storage() { [[ -n "$1" ]] && in_list "$1" "$(host_storages vztmpl)"; }
valid_bridge()  { [[ -n "$1" ]] && in_list "$1" "$(host_bridges)"; }
valid_password() { (( ${#1} >= 5 )); }
valid_password_opt() { [[ -z "$1" ]] || valid_password "$1"; }

valid_hostname() {
  local label='[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
  (( ${#1} <= 253 )) && [[ "$1" =~ ^${label}(\.${label})*$ ]]
}

valid_ipv4() {
  local o
  local -a parts
  [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  IFS=. read -ra parts <<<"$1"
  for o in "${parts[@]}"; do
    (( 10#$o <= 255 )) || return 1
  done
}

valid_cidr4() {
  [[ "$1" == */* ]] || return 1
  local addr=${1%/*} prefix=${1#*/}
  valid_ipv4 "$addr" && is_uint "$prefix" && (( 10#$prefix >= 1 && 10#$prefix <= 32 ))
}

valid_ip_setting() { [[ "$1" == dhcp ]] || valid_cidr4 "$1"; }

valid_dns() {
  local s
  for s in $1; do
    valid_ipv4 "$s" || [[ "$s" =~ ^[0-9A-Fa-f:]+$ && "$s" == *:* ]] || return 1
  done
}

valid_ssh_key() {
  [[ "$1" =~ ^(ssh-|ecdsa-|sk-) ]] && ssh-keygen -l -f /dev/stdin <<<"$1" >/dev/null 2>&1
}
valid_ssh_key_opt() { [[ -z "$1" ]] || valid_ssh_key "$1"; }

# ---- menu layer (the only code that reads input) ----------------------------

UI_TITLE="proxmox-recipes"

ui_is_set() { [[ -n "${!1+x}" ]]; }

ui_require_tty() {   # <variable that needs an answer>
  if [[ ! -t 0 || ! -t 1 ]]; then
    die "No terminal for the menus. Preset $1 (see misc/build.func) or run from an interactive shell."
  fi
  command -v whiptail >/dev/null 2>&1 || die "whiptail is not installed."
}

ui_cancelled() {
  if (( RCP_TTY )); then clear; fi
  log_discard_pending
  say_warn "Cancelled. Nothing was created."
  exit 0
}

ui_error() { whiptail --title "$UI_TITLE" --msgbox "$1" 10 70; }

ui_input() {   # <var> <prompt> <default> <validator> <error text>
  local var=$1 prompt=$2 value=$3 check=$4 err=$5
  if ui_is_set "$var"; then return 0; fi
  ui_require_tty "$var"
  while true; do
    value=$(whiptail --title "$UI_TITLE" --inputbox "$prompt" 11 70 "$value" 3>&1 1>&2 2>&3) || ui_cancelled
    if "$check" "$value"; then
      printf -v "$var" '%s' "$value"
      return 0
    fi
    ui_error "$err"
  done
}

ui_menu() {   # <var> <prompt> <default tag> <tag> <description> [...]
  local var=$1 prompt=$2 def=$3 value rows
  shift 3
  if ui_is_set "$var"; then return 0; fi
  ui_require_tty "$var"
  rows=$(( $# / 2 ))
  (( rows > 10 )) && rows=10
  value=$(whiptail --title "$UI_TITLE" --default-item "$def" \
    --menu "$prompt" $(( rows + 9 )) 74 "$rows" "$@" 3>&1 1>&2 2>&3) || ui_cancelled
  printf -v "$var" '%s' "$value"
}

ui_yesno() {   # <var> <prompt> <default yes|no>
  local var=$1 prompt=$2 rc=0
  local -a extra=()
  if ui_is_set "$var"; then return 0; fi
  ui_require_tty "$var"
  [[ "$3" == no ]] && extra=(--defaultno)
  whiptail --title "$UI_TITLE" "${extra[@]}" --yesno "$prompt" 20 74 || rc=$?
  case $rc in
    0) printf -v "$var" 'yes' ;;
    1) printf -v "$var" 'no' ;;
    *) ui_cancelled ;;
  esac
}

ui_password() {   # <var> <prompt>
  local var=$1 a b
  if ui_is_set "$var"; then return 0; fi
  ui_require_tty "$var"
  while true; do
    a=$(whiptail --title "$UI_TITLE" --passwordbox "$2" 10 70 3>&1 1>&2 2>&3) || ui_cancelled
    b=$(whiptail --title "$UI_TITLE" --passwordbox "Type the password again:" 10 70 3>&1 1>&2 2>&3) || ui_cancelled
    if [[ "$a" != "$b" ]]; then
      ui_error "The passwords do not match."
    elif ! valid_password "$a"; then
      ui_error "Use at least 5 characters."
    else
      printf -v "$var" '%s' "$a"
      return 0
    fi
  done
}

ui_ask_mode() {
  ui_menu SETUP_MODE "How should the ${APP_NAME} container be set up?" default \
    default "Use defaults: ${APP_DEFAULT_CORES} core, ${APP_DEFAULT_RAM_MB} MB RAM, ${APP_DEFAULT_DISK_GB} GB disk, DHCP" \
    advanced "Choose every setting yourself"
}

ui_ask_advanced() {
  local def_ctid s net_choice auth_choice   # the *_choice vars start unset
  local -a items

  def_ctid=$(default_ctid)
  ui_input CT_ID "Container ID:" "$def_ctid" ctid_ok \
    "The ID must be a number of 100 or more that no other container or VM uses."
  ui_input CT_HOSTNAME "Hostname:" "$APP_DEFAULT_HOSTNAME" valid_hostname \
    "Use letters, digits and hyphens (dots between labels), not starting or ending with a hyphen."
  ui_input CT_CORES "CPU cores (1-$(nproc)):" "$APP_DEFAULT_CORES" valid_cores \
    "Enter a whole number between 1 and $(nproc)."
  ui_input CT_RAM_MB "Memory in MB:" "$APP_DEFAULT_RAM_MB" valid_ram \
    "Enter a whole number of at least 128."
  ui_input CT_DISK_GB "Root disk size in GB:" "$APP_DEFAULT_DISK_GB" valid_disk \
    "Enter a whole number of at least 1."

  if ! ui_is_set CT_STORAGE; then
    items=()
    while IFS= read -r s; do
      [[ -n "$s" ]] && items+=("$s" "$(storage_free_gib "$s") GiB free")
    done <<<"$(host_storages rootdir)"
    (( ${#items[@]} > 0 )) || die "No active storage on this host can hold container disks ('rootdir' content)."
    ui_menu CT_STORAGE "Storage for the container's root disk:" "$(default_storage)" "${items[@]}"
  fi

  if ! ui_is_set CT_BRIDGE; then
    items=()
    while IFS= read -r s; do
      [[ -n "$s" ]] && items+=("$s" "network bridge")
    done <<<"$(host_bridges)"
    (( ${#items[@]} > 0 )) || die "No network bridge found on this host."
    ui_menu CT_BRIDGE "Network bridge:" "$(default_bridge)" "${items[@]}"
  fi

  if ! ui_is_set CT_IP; then
    ui_menu net_choice "IPv4 address:" dhcp \
      dhcp "Get an address from DHCP" \
      static "Set a static address"
    if [[ "$net_choice" == dhcp ]]; then
      CT_IP=dhcp
    else
      ui_input CT_IP "Static IPv4 address with prefix, e.g. 192.168.1.50/24:" "" valid_cidr4 \
        "Enter an IPv4 address with a prefix length, e.g. 192.168.1.50/24."
    fi
  fi
  if [[ "$CT_IP" != dhcp ]]; then
    ui_input CT_GATEWAY "Gateway IPv4 address:" "" valid_ipv4 \
      "Enter an IPv4 address, e.g. 192.168.1.1."
  fi

  ui_input CT_VLAN "VLAN tag (leave blank for none):" "" valid_vlan \
    "Enter a VLAN tag from 1 to 4094, or leave it blank."
  ui_input CT_DNS "DNS servers, space separated (leave blank to use the host's):" "" valid_dns \
    "Enter IP addresses separated by spaces, or leave it blank."

  if ! ui_is_set CT_PASSWORD && ! ui_is_set CT_SSH_KEY; then
    ui_menu auth_choice "Root login:" password \
      password "Set a root password" \
      sshkey "Add an SSH public key" \
      both "Password and SSH key" \
      none "Neither (use 'pct enter' from the host)"
    case $auth_choice in
      password) CT_SSH_KEY="" ;;
      sshkey)   CT_PASSWORD="" ;;
      none)     CT_PASSWORD=""; CT_SSH_KEY="" ;;
    esac
  fi
  ui_password CT_PASSWORD "Root password (at least 5 characters):"
  ui_input CT_SSH_KEY "Paste the SSH public key for root:" "" valid_ssh_key \
    "That is not a valid SSH public key (ssh-ed25519 AAAA..., ssh-rsa AAAA..., ...)."

  ui_yesno CT_ONBOOT "Start the container when the host boots?" yes
}

ui_confirm() {
  ui_yesno CONFIRM_CREATE "$(settings_text)

Create this container?" yes
  [[ "$CONFIRM_CREATE" == yes ]] || ui_cancelled
}

# Called from rcp_fail (core.func) when something goes wrong.
ui_ask_destroy() {
  if ui_is_set DESTROY_ON_FAILURE; then return 0; fi
  if [[ -t 0 && -t 1 ]] && command -v whiptail >/dev/null 2>&1; then
    if whiptail --title "$UI_TITLE" --yesno \
      "Setting up container ${CT_ID} failed.\n\nDestroy the half-built container?" 10 70; then
      DESTROY_ON_FAILURE=yes
    else
      DESTROY_ON_FAILURE=no
    fi
  else
    DESTROY_ON_FAILURE=no
  fi
}

# ---- recipe hooks -----------------------------------------------------------

app_hook() {   # <hook name>: run it if the recipe defines it
  if declare -F "$1" >/dev/null; then "$1"; fi
}

install_is_interactive() { [[ "${APP_INSTALL_INTERACTIVE:-no}" == yes ]]; }

# Fail before anything is created if the app's installer will need a
# terminal and there is none.
check_interactive_install() {
  if install_is_interactive && [[ ! -t 0 || ! -t 1 ]]; then
    die "The ${APP_NAME} installer asks its own questions, so this recipe must run from an interactive shell."
  fi
}

# ---- settings ---------------------------------------------------------------

fill_defaults() {
  if ! ui_is_set CT_ID;        then CT_ID=$(default_ctid); fi
  if ! ui_is_set CT_HOSTNAME;  then CT_HOSTNAME=$APP_DEFAULT_HOSTNAME; fi
  if ! ui_is_set CT_CORES;     then CT_CORES=$APP_DEFAULT_CORES; fi
  if ! ui_is_set CT_RAM_MB;    then CT_RAM_MB=$APP_DEFAULT_RAM_MB; fi
  if ! ui_is_set CT_DISK_GB;   then CT_DISK_GB=$APP_DEFAULT_DISK_GB; fi
  if ! ui_is_set CT_SWAP_MB;   then CT_SWAP_MB=512; fi
  if ! ui_is_set CT_STORAGE;   then CT_STORAGE=$(default_storage); fi
  if ! ui_is_set TMPL_STORAGE; then TMPL_STORAGE=$(default_tmpl_storage); fi
  if ! ui_is_set CT_BRIDGE;    then CT_BRIDGE=$(default_bridge); fi
  if ! ui_is_set CT_IP;        then CT_IP=dhcp; fi
  if ! ui_is_set CT_GATEWAY;   then CT_GATEWAY=""; fi
  if ! ui_is_set CT_VLAN;      then CT_VLAN=""; fi
  if ! ui_is_set CT_DNS;       then CT_DNS=""; fi
  if ! ui_is_set CT_PASSWORD;  then CT_PASSWORD=""; fi
  if ! ui_is_set CT_SSH_KEY;   then CT_SSH_KEY=""; fi
  if ! ui_is_set CT_ONBOOT;    then CT_ONBOOT=yes; fi
}

validate_settings() {
  step_begin "Checking settings"
  [[ -n "$CT_STORAGE" ]] || die "No active storage on this host can hold container disks ('rootdir' content). Enable one, or set CT_STORAGE."
  valid_mode "$SETUP_MODE"       || die "SETUP_MODE must be 'default' or 'advanced' (got '$SETUP_MODE')."
  valid_ctid "$CT_ID"            || die "CT_ID '$CT_ID' is not a valid container ID."
  ctid_free "$CT_ID"             || die "ID $CT_ID is already used by another container or VM."
  valid_hostname "$CT_HOSTNAME"  || die "CT_HOSTNAME '$CT_HOSTNAME' is not a valid hostname."
  valid_cores "$CT_CORES"        || die "CT_CORES must be between 1 and $(nproc)."
  valid_ram "$CT_RAM_MB"         || die "CT_RAM_MB must be at least 128."
  valid_disk "$CT_DISK_GB"       || die "CT_DISK_GB must be at least 1."
  valid_swap "$CT_SWAP_MB"       || die "CT_SWAP_MB must be a whole number."
  valid_storage "$CT_STORAGE"    || die "Storage '$CT_STORAGE' is not an active storage that can hold container disks. Usable: $(host_storages rootdir | paste -sd' ' -)"
  valid_tmpl_storage "$TMPL_STORAGE" || die "Storage '$TMPL_STORAGE' is not an active storage that can hold templates."
  valid_bridge "$CT_BRIDGE"      || die "Bridge '$CT_BRIDGE' does not exist on this host."
  valid_ip_setting "$CT_IP"      || die "CT_IP must be 'dhcp' or an address like 192.168.1.50/24 (got '$CT_IP')."
  if [[ "$CT_IP" != dhcp ]]; then
    valid_ipv4 "$CT_GATEWAY"     || die "A static CT_IP needs a valid CT_GATEWAY."
  fi
  valid_vlan "$CT_VLAN"          || die "CT_VLAN must be 1-4094 or empty."
  valid_dns "$CT_DNS"            || die "CT_DNS must be IP addresses separated by spaces."
  valid_password_opt "$CT_PASSWORD" || die "CT_PASSWORD must be at least 5 characters."
  valid_ssh_key_opt "$CT_SSH_KEY"   || die "CT_SSH_KEY is not a valid SSH public key."
  valid_yesno "$CT_ONBOOT"       || die "CT_ONBOOT must be 'yes' or 'no'."
  app_hook app_validate_options
  step_end
}

settings_text() {
  local net login=()
  if [[ "$CT_IP" == dhcp ]]; then net="DHCP"; else net="$CT_IP via $CT_GATEWAY"; fi
  [[ -n "$CT_VLAN" ]] && net+=", VLAN $CT_VLAN"
  [[ -n "$CT_PASSWORD" ]] && login+=("password")
  [[ -n "$CT_SSH_KEY" ]] && login+=("SSH key")
  (( ${#login[@]} )) || login=("none (pct enter)")
  printf '%s\n' \
    "App:       ${APP_NAME} (Debian ${APP_DEBIAN_RELEASE}, unprivileged)" \
    "CT ID:     ${CT_ID}" \
    "Hostname:  ${CT_HOSTNAME}" \
    "Resources: ${CT_CORES} core(s), ${CT_RAM_MB} MB RAM, ${CT_DISK_GB} GB disk" \
    "Storage:   ${CT_STORAGE} (template on ${TMPL_STORAGE})" \
    "Network:   ${CT_BRIDGE}, ${net}" \
    "DNS:       ${CT_DNS:-same as host}" \
    "Root:      ${login[*]}" \
    "On boot:   ${CT_ONBOOT}"
  app_hook app_settings_text
}

collect_settings() {
  UI_TITLE="proxmox-recipes: ${APP_NAME}"
  ui_ask_mode
  valid_mode "$SETUP_MODE" || die "SETUP_MODE must be 'default' or 'advanced' (got '$SETUP_MODE')."
  if [[ "$SETUP_MODE" == advanced ]]; then
    ui_ask_advanced
  fi
  app_hook app_ask_options
  fill_defaults
  validate_settings
  ui_confirm
  log_line "Settings:"
  settings_text | sed 's/^/    /' >>"$RCP_LOG"
}

# ---- template ---------------------------------------------------------------

template_pattern() { printf '^debian-%s-standard_.*_amd64\\.tar\\.' "$APP_DEBIAN_RELEASE"; }

template_cached() {   # -> volid of newest matching template already on TMPL_STORAGE
  pveam list "$TMPL_STORAGE" 2>/dev/null |
    awk -v re="$(template_pattern)" 'NR > 1 { n = $1; sub(/^[^\/]*\//, "", n); if (n ~ re) print $1 }' |
    sort -V | tail -n 1
}

template_available() {   # -> file name of newest matching template upstream
  pveam available --section system 2>/dev/null |
    awk -v re="$(template_pattern)" '$2 ~ re { print $2 }' |
    sort -V | tail -n 1
}

prepare_template() {
  local name
  TEMPLATE_VOLID=$(template_cached)
  if [[ -n "$TEMPLATE_VOLID" ]]; then
    say_ok "Template ${TEMPLATE_VOLID} already downloaded"
    return 0
  fi
  run_step "Updating template list" pveam update
  name=$(template_available)
  [[ -n "$name" ]] || die "No Debian ${APP_DEBIAN_RELEASE} template found in 'pveam available'."
  run_step "Downloading ${name}" pveam download "$TMPL_STORAGE" "$name"
  TEMPLATE_VOLID="${TMPL_STORAGE}:vztmpl/${name}"
}

# ---- container --------------------------------------------------------------

CT_CREATED=0

net0_spec() {
  local n="name=eth0,bridge=${CT_BRIDGE}"
  if [[ "$CT_IP" == dhcp ]]; then
    n+=",ip=dhcp"
  else
    n+=",ip=${CT_IP},gw=${CT_GATEWAY}"
  fi
  [[ -n "$CT_VLAN" ]] && n+=",tag=${CT_VLAN}"
  printf '%s' "$n"
}

create_container() {
  local keyfile=""
  local -a args=(
    --hostname "$CT_HOSTNAME"
    --ostype debian
    --unprivileged 1
    --features nesting=1
    --cores "$CT_CORES"
    --memory "$CT_RAM_MB"
    --swap "$CT_SWAP_MB"
    --rootfs "${CT_STORAGE}:${CT_DISK_GB}"
    --net0 "$(net0_spec)"
    --onboot "$([[ "$CT_ONBOOT" == yes ]] && echo 1 || echo 0)"
    --timezone host
    --tags proxmox-recipes
    --description "Created by proxmox-recipes (${APP_SLUG})"
  )
  [[ -n "$CT_DNS" ]] && args+=(--nameserver "$CT_DNS")
  if [[ -n "$CT_SSH_KEY" ]]; then
    rcp_mktemp keyfile
    printf '%s\n' "$CT_SSH_KEY" >"$keyfile"
    args+=(--ssh-public-keys "$keyfile")
  fi

  # Check again right before creating: never claim an ID someone else took.
  ctid_free "$CT_ID" || die "ID $CT_ID was taken while settings were being collected."
  run_step "Creating container ${CT_ID}" pct create "$CT_ID" "$TEMPLATE_VOLID" "${args[@]}"
  CT_CREATED=1
  return 0
}

ct_ipv4() {
  pct exec "$CT_ID" -- ip -4 -o addr show dev eth0 scope global 2>/dev/null |
    awk '{ print $4; exit }'
}

wait_for_network() {
  local i ip=""
  for (( i = 0; i < 60; i++ )); do
    ip=$(ct_ipv4) || true
    [[ -n "$ip" ]] && break
    sleep 1
  done
  if [[ -z "$ip" ]]; then
    echo "eth0 got no IPv4 address within 60 seconds"
    return 1
  fi
  echo "eth0: $ip"
  for (( i = 0; i < 30; i++ )); do
    if pct exec "$CT_ID" -- getent hosts deb.debian.org; then
      pct exec "$CT_ID" -- timeout 10 bash -c 'exec 3<>/dev/tcp/deb.debian.org/80'
      echo "deb.debian.org reachable"
      return 0
    fi
    sleep 1
  done
  echo "DNS lookup of deb.debian.org failed for 30 seconds"
  return 1
}

set_root_password() {
  printf 'root:%s\n' "$CT_PASSWORD" | pct exec "$CT_ID" -- chpasswd
}

start_container() {
  run_step "Starting container ${CT_ID}" pct start "$CT_ID"
  run_step "Waiting for network" wait_for_network
  if [[ -n "$CT_PASSWORD" ]]; then
    run_step "Setting root password" set_root_password
  fi
}

# Push the container-side engine and the app script into the container,
# then run the install phases there (see misc/install.func).
push_repo_file() {   # <repo-relative path> <path in container>
  local tmp rc=0
  tmp=$(mktemp)
  recipe_fetch "$1" >"$tmp" || rc=$?
  if (( rc == 0 )); then
    pct push "$CT_ID" "$tmp" "$2" --perms 0644 || rc=$?
  else
    echo "could not load $1"
  fi
  rm -f -- "$tmp"
  return "$rc"
}

push_install_files() {
  pct exec "$CT_ID" -- mkdir -p /usr/local/lib/recipe
  push_repo_file misc/install.func /usr/local/lib/recipe/install.func
  push_repo_file "$APP_INSTALL_SCRIPT" /usr/local/lib/recipe/app.sh
}

container_phase() {   # <install.func phase function> [tty]
  local name run="source /usr/local/lib/recipe/install.func && $1"
  local -a envs=(
    RECIPE_APP_NAME="$APP_NAME"
    RECIPE_APP_SLUG="$APP_SLUG"
    RECIPES_RAW_BASE="$RECIPES_RAW_BASE"
    TERM="${TERM:-xterm}"
  )
  for name in "${APP_ENV_VARS[@]}"; do
    envs+=("${name}=${!name}")
  done
  if [[ "${2:-}" == tty ]]; then
    # pct exec gives the process no controlling terminal in the container,
    # so programs that open /dev/tty (dialog, used by Pi-hole's installer)
    # fail. script(1), from bsdutils (essential in Debian), runs the phase
    # on a new pseudo-terminal inside the container and returns its exit
    # code.
    pct exec "$CT_ID" -- env "${envs[@]}" \
      script -qefc "bash -c '${run}'" /dev/null
  else
    pct exec "$CT_ID" -- env "${envs[@]}" bash -c "$run"
  fi
}

# The app's own installer asks questions: run it on the user's terminal
# instead of in run_step. Its output goes to the screen, not the log.
run_interactive_install() {
  RCP_STEP="Installing ${APP_NAME}"
  log_line "STEP: ${RCP_STEP} (interactive, output not logged)"
  say_head "Starting the ${APP_NAME} installer"
  say "   It asks its own questions. Answer them to continue."
  container_phase install_app tty
  log_line "STEP OK: ${RCP_STEP}"
  RCP_STEP=""
  say_ok "Installing ${APP_NAME}"
}

run_app_install() {
  run_step "Copying install scripts" push_install_files
  run_step "Preparing container" container_phase install_prepare
  if install_is_interactive; then
    run_interactive_install
  else
    run_step "Installing ${APP_NAME}" container_phase install_app
  fi
  run_step "Finishing setup" container_phase install_finish
}

# ---- container notes --------------------------------------------------------
#
# The Notes panel in the Proxmox UI shows the container's description,
# rendered as Markdown with a sanitized subset of HTML: div align, h1-h6,
# links and tables are allowed; style attributes are not, so the title
# uses the UI's own font.

APP_WEB_URL=""
RECIPES_SUPPORT_URL="https://ko-fi.com/farmnerds"
RECIPES_SUPPORT_BUTTON="https://storage.ko-fi.com/cdn/kofi6.png?v=6"

ct_ip_only() {
  local ip
  ip=$(ct_ipv4) || true
  printf '%s' "${ip%%/*}"
}

# Sets APP_WEB_URL from the app's live config (app_web in install/<app>.sh),
# so the link follows the port the app really uses.
find_web_url() {
  local ip scheme="" port="" path="" host
  ip=$(ct_ip_only)
  [[ -n "$ip" ]] || return 0
  read -r scheme port path < <(pct exec "$CT_ID" -- bash -c \
    'source /usr/local/lib/recipe/install.func && load_app && app_web_text' 2>/dev/null) || true
  [[ "$scheme" == http || "$scheme" == https ]] || return 0
  is_uint "$port" || return 0
  [[ "$path" == /* ]] || path=/
  host=$ip
  if [[ ! ( "$scheme" == http && "$port" == 80 ) && ! ( "$scheme" == https && "$port" == 443 ) ]]; then
    host+=":${port}"
  fi
  APP_WEB_URL="${scheme}://${host}${path}"
}

md_cell() {   # <text> -> safe inside a Markdown table cell
  # Outside `code spans`, & < > are escaped so they show as text, not HTML.
  # Inside them Markdown already shows text as-is, so escaping there would
  # show "&amp;" instead of "&". A | is escaped everywhere: it would
  # otherwise end the table cell (GFM accepts \| inside code spans too).
  # A final unmatched backtick does not start a code span, so the text
  # after it is escaped like any other text.
  local s=$1 out="" part ticks in_code=0
  ticks=${s//[!\`]/}
  while [[ "$s" == *'`'* ]]; do
    part=${s%%'`'*}
    s=${s#*'`'}
    out+="$(md_escape "$part" "$in_code")"'`'
    ticks=${ticks#?}
    in_code=$(( 1 - in_code ))
    # An opening backtick with no closing one left: plain text after all.
    if (( in_code == 1 && ${#ticks} == 0 )); then in_code=0; fi
  done
  out+="$(md_escape "$s" "$in_code")"
  printf '%s' "$out"
}

md_escape() {   # <text> <in code span: 0|1>
  local s=$1
  # Replacements are quoted: in bash 5.2+ a bare & means "the match".
  if [[ "$2" == 0 ]]; then
    s=${s//'&'/'&amp;'}
    s=${s//'<'/'&lt;'}
    s=${s//'>'/'&gt;'}
  fi
  s=${s//'|'/'\|'}
  printf '%s' "$s"
}

notes_row() {   # <label> <value>
  printf '| **%s** | %s |\n' "$1" "$(md_cell "$2")"
}

notes_text() {
  local ip
  ip=$(ct_ip_only)
  printf '<div align="center">\n\n<h1>%s</h1>\n\n' "$(md_cell "$APP_NAME")"
  if [[ -n "$APP_WEB_URL" ]]; then
    printf '<h5><a href="%s" target="_blank">Open the web UI: %s</a></h5>\n\n' "$APP_WEB_URL" "$APP_WEB_URL"
  fi
  # The notes sanitizer drops style attributes, so size the button with height.
  printf 'Do you appreciate the recipes?\n\n'
  printf '<a href="%s" target="_blank"><img height="36" src="%s" alt="Buy Me a Coffee at ko-fi.com"></a>\n\n' \
    "$RECIPES_SUPPORT_URL" "$RECIPES_SUPPORT_BUTTON"
  printf '</div>\n\n| | |\n| --- | --- |\n'
  notes_row "Container" "${CT_ID} (${CT_HOSTNAME})"
  if [[ "$CT_IP" == dhcp ]]; then
    notes_row "IP address" "${ip:-unknown} (from DHCP: reserve it so it does not change)"
  else
    notes_row "IP address" "${ip:-unknown} (static)"
  fi
  app_hook app_notes_rows
  notes_row "Update" "\`pct enter ${CT_ID}\` then \`recipe update\`"
  notes_row "Details" "\`pct enter ${CT_ID}\` then \`recipe info\`"
  notes_row "Installed" "$(date '+%F') by proxmox-recipes"
  printf '| **Docs** | [%s](https://github.com/farmnerds-net/proxmox-recipes/blob/%s/docs/apps/%s.md) |\n' \
    "$(md_cell "$APP_NAME")" "$RECIPES_REF" "$APP_SLUG"
}

write_notes() {
  pct set "$CT_ID" --description "$(notes_text)"
}

show_summary() {
  local ip
  ip=$(ct_ipv4) || true
  say_head "${APP_NAME} container ${CT_ID} is ready"
  settings_text | sed 's/^/  /'
  say "  IPv4:      ${ip:-unknown}"
  say "  Console:   pct enter ${CT_ID}"
  say "  Log:       ${RCP_LOG}"
  if [[ -n "$APP_WEB_URL" ]]; then
    say "  Web UI:    ${APP_WEB_URL}"
  fi
  say "  Notes:     container ${CT_ID} > Summary in the Proxmox UI"
  app_hook app_summary_text
}

# Called by rcp_fail (core.func) after a failure has been reported.
rcp_on_failure() {
  if (( CT_CREATED != 1 )); then
    say "   No container was created."
    return 0
  fi
  ui_ask_destroy
  if [[ "$DESTROY_ON_FAILURE" == yes ]]; then
    say "   Destroying container ${CT_ID}..."
    pct stop "$CT_ID" >>"$RCP_LOG" 2>&1
    if pct destroy "$CT_ID" --purge >>"$RCP_LOG" 2>&1; then
      say_ok "Container ${CT_ID} destroyed"
    else
      say_err "Could not destroy container ${CT_ID}; see $RCP_LOG"
    fi
  else
    say "   Container ${CT_ID} was left in place. Remove it with: pct destroy ${CT_ID} --purge"
  fi
}

# ---- entry point ------------------------------------------------------------

recipe_main() {
  : "${APP_NAME:?}" "${APP_SLUG:?}" "${APP_DEBIAN_RELEASE:?}" "${APP_DEFAULT_HOSTNAME:?}"
  : "${APP_DEFAULT_CORES:?}" "${APP_DEFAULT_RAM_MB:?}" "${APP_DEFAULT_DISK_GB:?}"
  : "${APP_INSTALL_SCRIPT:?}"
  if ! declare -p APP_ENV_VARS >/dev/null 2>&1; then APP_ENV_VARS=(); fi
  rcp_install_traps
  log_start "$APP_SLUG"
  if [[ -n "${RECIPES_SRC:-}" ]]; then
    log_line "Source: local checkout ${RECIPES_SRC}"
  else
    log_line "Source: ${RECIPES_RAW_BASE}"
  fi
  say_head "proxmox-recipes: ${APP_NAME}"
  preflight_checks
  check_interactive_install
  collect_settings
  log_bind_ctid "$APP_SLUG" "$CT_ID"
  prepare_template
  create_container
  start_container
  run_app_install
  find_web_url
  run_step "Adding notes" write_notes
  show_summary
}
